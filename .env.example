# Twilio Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/sms_waitlist
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sms_waitlist
DB_USER=postgres
DB_PASSWORD=your_db_password_here

# Server Configuration
NODE_ENV=development
PORT=3000
HOST=localhost

# Session & Security
SESSION_SECRET=your_random_session_secret_key_change_this_in_production
JWT_SECRET=your_random_jwt_secret_key_change_this_in_production

# Email Configuration (for owner notifications/password reset if needed)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM=noreply@smswaitlist.com

# Application URLs
BACKEND_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
WEBHOOK_URL=http://localhost:3000/api/twilio/webhook

# Feature Flags
ENABLE_AUTO_RESPONDER=true
ENABLE_SMS_NOTIFICATIONS=true
CONVERSATION_TIMEOUT_MINUTES=30

# Logging
LOG_LEVEL=debug
SENTRY_DSN=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# SMS Configuration
SMS_RESPONSE_TIMEOUT_MS=30000
MAX_QUEUE_SIZE=100
CONVERSATION_STATE_TTL_MINUTES=30